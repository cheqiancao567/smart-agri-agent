# 复制本文件为 .env 后填入真实值。
# .env 已被 .gitignore 排除，永远不会被提交到 git。

# ---- 大模型 ----
# 用哪一家：deepseek / qwen / ollama
# 开发调试建议用 ollama（免费、可离线）；正式演示切云端（质量稳）
LLM_PROVIDER=deepseek

# DeepSeek 开放平台 https://platform.deepseek.com
# 可用模型只有两个：deepseek-flash（便宜、支持图像理解）/ deepseek-v4-pro（更强更贵）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 本地 Ollama（零成本，模型导入方式见 docs/env.md 第 7 节）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 阿里云百炼（DashScope），项目二也会用到
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- MQTT ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=sensors

# ---- 数据库 ----
DATABASE_URL=sqlite:///data/app.db
