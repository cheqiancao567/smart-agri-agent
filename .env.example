# 复制本文件为 .env 后填入真实值。
# .env 已被 .gitignore 排除，永远不会被提交到 git。

# ---- 大模型 ----
# 开发期用本地 Ollama（零成本），演示期切云端 API
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# 注册 DeepSeek 开放平台后填这里
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 阿里云百炼（DashScope），项目二也会用它
QWEN_API_KEY=

# ---- MQTT ----
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=sensors

# ---- 数据库 ----
DATABASE_URL=sqlite:///data/app.db
